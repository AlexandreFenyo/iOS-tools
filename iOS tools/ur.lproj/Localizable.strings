/* Phrases à trou (%@ = adresse ou nom) */
"Parallel TCP connections will be established to %@ on TCP ports from 1 to 65535, to find open services. The new discovered services will be displayed on the bottom view. You can interrupt this task by pressing the STOP button." = "کھلی سروسز تلاش کرنے کے لیے %@ کے ساتھ 1 سے 65535 تک کے TCP پورٹس پر متوازی TCP کنکشنز قائم کیے جائیں گے۔ نئی دریافت ہونے والی سروسز نیچے والے منظر میں دکھائی جائیں گی۔ آپ STOP بٹن دبا کر یہ کام روک سکتے ہیں۔";
"A TCP connection to the Discard port (9/TCP) of %@ will be established. Data will then be sent on this connection at the maximum throughput available, by this device to this target host, to evaluate the maximum speed that can be reached in the outgoing direction. You can interrupt this task by pressing the STOP button." = "%@ کے Discard پورٹ (9/TCP) سے ایک TCP کنکشن قائم کیا جائے گا۔ پھر اس کنکشن پر اس ڈیوائس سے ہدف ہوسٹ کی طرف زیادہ سے زیادہ دستیاب اسپیڈ سے ڈیٹا بھیجا جائے گا، تاکہ جانے والی سمت میں حاصل ہونے والی زیادہ سے زیادہ اسپیڈ کا اندازہ لگایا جا سکے۔ آپ STOP بٹن دبا کر یہ کام روک سکتے ہیں۔";
"A TCP connection to the Chargen port (19/TCP) of %@ will be established. Data will then be received on this connection at the maximum throughput available, by this device from this target host, to evaluate the maximum speed that can be reached in the incoming direction. You can interrupt this task by pressing the STOP button." = "%@ کے Chargen پورٹ (19/TCP) سے ایک TCP کنکشن قائم کیا جائے گا۔ پھر اس کنکشن پر ہدف ہوسٹ سے اس ڈیوائس کی طرف زیادہ سے زیادہ دستیاب اسپیڈ سے ڈیٹا وصول کیا جائے گا، تاکہ آنے والی سمت میں حاصل ہونے والی زیادہ سے زیادہ اسپیڈ کا اندازہ لگایا جا سکے۔ آپ STOP بٹن دبا کر یہ کام روک سکتے ہیں۔";
"ICMP packets of type ECHO_REQUEST will be sent to %@ at a rate of one packet per second. The target should reply with an ICMP packet of type ECHO_REPLY. The round trip type is computed and displayed on the chart. You can interrupt this task by pressing the STOP button." = "ECHO_REQUEST قسم کے ICMP پیکٹس فی سیکنڈ ایک پیکٹ کی شرح سے %@ کو بھیجے جائیں گے۔ ہدف کو ECHO_REPLY قسم کے ICMP پیکٹ سے جواب دینا چاہیے۔ راؤنڈ ٹرپ ٹائم کا حساب لگا کر اسے چارٹ پر دکھایا جاتا ہے۔ آپ STOP بٹن دبا کر یہ کام روک سکتے ہیں۔";
"found %@" = "%@ مل گیا";
"trying %@" = "%@ کو آزمایا جا رہا ہے";
"retrying %@" = "%@ کو دوبارہ آزمایا جا رہا ہے";
